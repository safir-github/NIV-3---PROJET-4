<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Stubborn - Don't compromise on your look{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>👕</text></svg>">
        
        {# On inclut la police Google Font Inter pour une typographie plus premium #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
        
        {% block stylesheets %}
            {# Importation du fichier CSS global #}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {# Détermination de la route courante pour styliser le lien actif #}
        {% set current_route = app.request.attributes.get('_route') %}

        <header class="main-header">
            <nav class="navbar">
                <div class="logo" style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center;">
                    <a href="{{ path('app_home') }}" style="display: flex; flex-direction: column; align-items: flex-start; text-decoration: none;">
                        <img src="{{ asset('images/Logo.png') }}" alt="Stubborn" style="height: 75px; width: auto; object-fit: contain;">
                        <span style="font-size: 11px; color: #666; font-weight: 600; margin-top: 4px; font-style: italic; font-family: 'Inter', sans-serif;">Don't compromise on your look</span>
                    </a>
                </div>
                <ul class="nav-links">
                    {# Lien Accueil présent pour tout le monde #}
                    <li>
                        <a href="{{ path('app_home') }}" class="{% if current_route == 'app_home' %}active-link{% endif %}">Accueil</a>
                    </li>

                    {% if app.user %}
                        {# Liens affichés uniquement pour les utilisateurs CONNECTÉS #}
                        <li>
                            <a href="{{ path('app_products') }}" class="{% if current_route == 'app_products' %}active-link{% endif %}">Boutique</a>
                        </li>
                        <li>
                            <a href="{{ path('app_cart') }}" class="{% if current_route == 'app_cart' %}active-link{% endif %}">Panier</a>
                        </li>
                        <li>
                            <a href="{{ path('app_logout') }}">Se déconnecter</a>
                        </li>
                    {% else %}
                        {# Liens affichés uniquement pour les utilisateurs NON CONNECTÉS #}
                        <li>
                            <a href="{{ path('app_login') }}" class="{% if current_route == 'app_login' %}active-link{% endif %}">Se connecter</a>
                        </li>
                        <li>
                            <a href="{{ path('app_register') }}" class="{% if current_route == 'app_register' %}active-link{% endif %}">S'inscrire</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </header>

        <main class="container">
            {# Affichage des messages flash de succès ou d'erreur #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }}" style="padding: 15px; margin-bottom: 20px; border-radius: 4px; background-color: {% if label == 'success' %}#d4edda{% else %}#f8d7da{% endif %}; color: {% if label == 'success' %}#155724{% else %}#721c24{% endif %}; border: 1px solid {% if label == 'success' %}#c3e6cb{% else %}#f5c6cb{% endif %};">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="main-footer">
            <p>&copy; {{ "now"|date("Y") }} Stubborn. Piccadilly Circus, London W1J 0DA, Royaume-Uni.</p>
        </footer>
    </body>
</html>
