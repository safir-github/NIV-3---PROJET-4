{% extends 'base.html.twig' %}

{% block title %}Accueil - Stubborn{% endblock %}

{% block body %}
    {# 1. Section Présentation de la Société Stubborn (données du brief) #}
    <section class="presentation-section">
        <h1>Stubborn</h1>
        <p class="slogan">"Don't compromise on your look"</p>
        <p class="description">
            Bienvenue chez Stubborn, votre boutique en ligne de sweat-shirts premium. Nous concevons nos modèles 
            avec exigence pour vous proposer des coupes parfaites et un style sans compromis.
        </p>
        <div class="contact-info" style="margin-top: 15px; font-size: 14px; color: #555;">
            <strong>Adresse :</strong> Piccadilly Circus, London W1J 0DA, Royaume-Uni | 
            <strong>Contact :</strong> stubborn@blabla.com
        </div>
    </section>

    {# 2. Section Produits mis en avant #}
    <section class="featured-section">
        <h2 style="text-align: center; font-size: 28px; margin-bottom: 30px;">Nos produits mis en avant</h2>
        
        <div class="products-grid">
            {% for product in featured_products %}
                <div class="product-card" style="text-align: left;">
                    {# Image du produit #}
                    <img src="{{ asset('images/' ~ product.image) }}" onerror="this.src='https://placehold.co/400x450?text={{ product.name }}';" alt="{{ product.name }}" style="width: 100%; display: block; margin-bottom: 15px;">
                    
                    {# Zone basse : Infos à gauche, Bouton "Voir" à droite si connecté #}
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100%; margin-top: auto;">
                        <div>
                            <h3 style="font-size: 18px; font-weight: 700; margin: 0; color: #111;">{{ product.name }}</h3>
                            <p class="price" style="font-size: 16px; font-weight: 600; color: #666; margin: 5px 0 0 0;">{{ product.price|number_format(2, ',', ' ') }} €</p>
                        </div>
                        {% if app.user %}
                            <div>
                                <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn" style="padding: 8px 18px; font-size: 13px; text-transform: uppercase;">Voir</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p style="text-align: center; color: #777; grid-column: 1 / -1;">Aucun produit mis en avant pour le moment.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
