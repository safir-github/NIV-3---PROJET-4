{% extends 'base.html.twig' %}

{% block title %}Commande Confirmée - Stubborn{% endblock %}

{% block body %}
    <div style="text-align: center; max-width: 600px; margin: 60px auto; padding: 40px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
        {# Icône de succès verte #}
        <div style="width: 80px; height: 80px; background-color: #d4edda; color: #28a745; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px auto; font-size: 40px; font-weight: 700;">
            ✓
        </div>

        <h1 style="font-size: 32px; font-weight: 700; color: #155724; margin-bottom: 20px;">Merci pour votre commande !</h1>
        
        <p style="font-size: 16px; color: #555; line-height: 1.6; margin-bottom: 30px;">
            Votre paiement a été accepté avec succès par Stripe. Notre équipe prépare votre colis avec le plus grand soin. Un email de confirmation récapitulatif vous a été envoyé.
        </p>

        <div style="border-top: 1px solid #eee; padding-top: 30px; display: flex; flex-direction: column; gap: 15px;">
            <p style="font-weight: 600; color: #333; margin: 0;">Adresse de livraison :</p>
            <p style="color: #666; font-style: italic; margin: 0;">{{ app.user.deliveryAddress }}</p>
        </div>

        <div style="margin-top: 40px;">
            <a href="{{ path('app_products') }}" class="btn" style="background-color: #000; padding: 12px 30px; font-size: 16px; border-radius: 6px;">
                Retourner à la boutique
            </a>
        </div>
    </div>
{% endblock %}
