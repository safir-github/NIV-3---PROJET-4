{% extends 'base.html.twig' %}

{% block title %}Mon Panier - Stubborn{% endblock %}

{% block body %}
    <div style="margin-bottom: 40px; text-align: center;">
        <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 10px;">Votre Panier</h1>
        <p style="color: #666; font-size: 14px;">Consultez et finalisez vos achats de sweat-shirts premium.</p>
    </div>

    {% if cart_items|length > 0 %}
        {# Liste des articles sous forme de blocs horizontaux indépendants selon le wireframe #}
        <div class="cart-items-list" style="display: flex; flex-direction: column; gap: 20px;">
            {% for item in cart_items %}
                <div style="display: flex; align-items: center; gap: 25px; background-color: #ffffff; padding: 25px; border-radius: 8px; border: 1px solid #eee; box-shadow: 0 4px 6px rgba(0,0,0,0.01);">
                    {# Partie gauche : Image du produit #}
                    <div style="flex-shrink: 0;">
                        <img src="{{ asset('images/' ~ item.product.image) }}" onerror="this.src='https://placehold.co/90x100?text={{ item.product.name }}';" alt="{{ item.product.name }}" style="width: 75px; height: 90px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;">
                    </div>

                    {# Partie centrale : Informations détaillées #}
                    <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 5px;">
                        <h3 style="font-size: 20px; font-weight: 700; margin: 0; color: #111;">{{ item.product.name }}</h3>
                        <div style="font-size: 15px; color: #555; display: flex; gap: 20px; margin-top: 5px;">
                            <span><strong>Taille :</strong> {{ item.size }}</span>
                            <span><strong>Quantité :</strong> {{ item.quantity }}</span>
                            <span><strong>Prix Unitaire :</strong> {{ item.product.price|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>

                    {# Partie droite : Sous-total et bouton Retirer #}
                    <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 15px; min-width: 180px;">
                        <div style="font-size: 20px; font-weight: 700; color: #111;">
                            {{ item.sub_total|number_format(2, ',', ' ') }} €
                        </div>
                        {# data-turbo="false" pour forcer un rechargement classique sécurisé sans interférence de Turbo #}
                        <a href="{{ path('app_cart_remove', {'id': item.product.id, 'size': item.size}) }}" data-turbo="false" class="btn" style="background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 8px 15px; font-size: 13px; font-weight: 600; border-radius: 4px; text-decoration: none;">
                            RETIRER DU PANIER
                        </a>
                    </div>
                </div>
            {% endfor %}

            {# Section Total et Validation globale #}
            <div style="display: flex; flex-direction: column; align-items: flex-end; margin-top: 15px; padding: 25px; background-color: #ffffff; border-radius: 8px; border: 1px solid #eee; box-shadow: 0 4px 6px rgba(0,0,0,0.01);">
                <div style="font-size: 24px; font-weight: 700; margin-bottom: 20px; color: #111; border: 1px solid #ddd; padding: 10px 20px; border-radius: 4px;">
                    TOTAL : {{ total|number_format(2, ',', ' ') }} €
                </div>
                
                <div style="display: flex; gap: 15px;">
                    <a href="{{ path('app_products') }}" class="btn" style="background-color: #6c757d; border-radius: 4px;">
                        CONTINUER MES ACHATS
                    </a>
                    
                    <a href="{{ path('app_cart_checkout') }}" data-turbo="false" class="btn" style="background-color: #28a745; border-radius: 4px;">
                        FINALISER MA COMMANDE
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        {# Panier vide #}
        <div style="text-align: center; padding: 60px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
            <p style="font-size: 18px; color: #777; margin-bottom: 30px;">Votre panier est actuellement vide.</p>
            <a href="{{ path('app_products') }}" class="btn">
                Aller sur la boutique
            </a>
        </div>
    {% endif %}
{% endblock %}
