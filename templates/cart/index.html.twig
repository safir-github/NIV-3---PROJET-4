{% extends 'base.html.twig' %}

{% block title %}Mon Panier - Stubborn{% endblock %}

{% block body %}
    <div style="margin-bottom: 40px; text-align: center;">
        <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 10px;">Votre Panier</h1>
        <p style="color: #666; font-size: 14px;">Consultez et finalisez vos achats de sweat-shirts premium.</p>
    </div>

    {% if cart_items|length > 0 %}
        {# Liste des articles sous forme de blocs horizontaux indépendants selon le wireframe #}
        <div class="cart-items-list" style="display: flex; flex-direction: column; gap: 20px;">
            {% for item in cart_items %}
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 25px; background-color: #ffffff; padding: 25px; border-radius: 8px; border: 1px solid #111; box-shadow: 0 4px 6px rgba(0,0,0,0.01); min-height: 120px;">
                    {# Partie gauche : Image du produit #}
                    <div style="flex-shrink: 0; width: 100px; height: 110px; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center; background-color: #fafafa;">
                        <img src="{{ asset('images/' ~ item.product.image) }}" onerror="this.src='https://placehold.co/90x100?text={{ item.product.name }}';" alt="{{ item.product.name }}" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>

                    {# Partie centrale : Informations alignées HORIZONTALEMENT (Nom, Prix, Taille, Quantité) #}
                    <div style="flex-grow: 1; display: flex; justify-content: space-around; align-items: center; gap: 20px; font-size: 16px; font-family: 'Inter', sans-serif; font-weight: 600; color: #111;">
                        <span>Nom : {{ item.product.name }}</span>
                        <span>Prix : {{ item.product.price|number_format(2, ',', ' ') }} €</span>
                        <span>Taille : {{ item.size }}</span>
                        
                        {# Formulaire en ligne de modification de la quantité #}
                        <form action="{{ path('app_cart_update', {'id': item.product.id, 'size': item.size}) }}" method="post" data-turbo="false" style="display: inline-flex; align-items: center; gap: 8px; margin: 0;">
                            <label style="font-size: 15px; font-weight: 600; color: #111;">Quantité :</label>
                            <input type="number" name="quantity" value="{{ item.quantity }}" min="1" onchange="this.form.submit()" style="width: 55px; padding: 5px; border: 1px solid #111; border-radius: 4px; text-align: center; font-size: 15px; font-weight: bold; font-family: 'Inter', sans-serif;">
                        </form>
                    </div>

                    {# Partie droite : Bouton Retirer du panier (avec bordure et fond blanc) #}
                    <div style="display: flex; flex-direction: column; align-items: flex-end; justify-content: flex-end; height: 110px; min-width: 180px;">
                        <a href="{{ path('app_cart_remove', {'id': item.product.id, 'size': item.size}) }}" data-turbo="false" class="btn" style="background-color: #ffffff; color: #111; border: 1px solid #111; padding: 10px 20px; font-size: 13px; font-weight: 700; border-radius: 6px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;">
                            RETIRER DU PANIER
                        </a>
                    </div>
                </div>
            {% endfor %}

            {# Section Validation globale à droite selon le wireframe #}
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 15px; margin-top: 15px; width: 100%;">
                {# Ligne 1 : Boîte de Total (gauche) + Finaliser ma commande (droite) #}
                <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap; justify-content: flex-end;">
                    <div style="font-size: 18px; font-weight: 700; color: #111; border: 1px solid #111; padding: 12px 30px; background-color: #ffffff; border-radius: 4px; font-family: 'Inter', sans-serif; text-transform: uppercase; letter-spacing: 0.5px;">
                        TOTAL: {{ total|number_format(2, ',', ' ') }} €
                    </div>
                    
                    <a href="{{ path('app_cart_checkout') }}" data-turbo="false" class="btn" style="background-color: #f8cbd0; color: #111; border: 1px solid #111; padding: 12px 30px; font-size: 14px; font-weight: 700; border-radius: 6px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;">
                        FINALISER MA COMMANDE
                    </a>
                </div>

                {# Ligne 2 : Bouton Continuer mes achats empilé en dessous #}
                <div>
                    <a href="{{ path('app_products') }}" class="btn" style="background-color: #d6ebd3; color: #111; border: 1px solid #111; padding: 12px 30px; font-size: 14px; font-weight: 700; border-radius: 6px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;">
                        CONTINUER MES ACHATS
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        {# Panier vide #}
        <div style="text-align: center; padding: 60px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
            <p style="font-size: 18px; color: #777; margin-bottom: 30px;">Votre panier est actuellement vide.</p>
            <a href="{{ path('app_products') }}" class="btn">
                Aller sur la boutique
            </a>
        </div>
    {% endif %}
{% endblock %}
