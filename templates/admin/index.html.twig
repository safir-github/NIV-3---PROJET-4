{% extends 'base.html.twig' %}

{% block title %}Back-Office - Stubborn{% endblock %}

{% block body %}
    <div style="margin-bottom: 30px; text-align: center;">
        <h1 style="font-size: 32px; font-weight: 700; margin: 0 0 10px 0;">Back-Office</h1>
        <p style="color: #666; font-size: 14px;">Gestion complète du catalogue de sweat-shirts et des stocks par taille.</p>
    </div>

    {# ========================================== #}
    {# 1. FORMULAIRE D'AJOUT D'UN PRODUIT (HAUT) #}
    {# ========================================== #}
    <div style="background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 25px; border-radius: 8px; margin-bottom: 45px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
        <h2 style="font-size: 18px; font-weight: 700; margin: 0 0 20px 0; color: #721c24; border-bottom: 1px solid #f5c6cb; padding-bottom: 10px;">
            Ajouter un nouveau produit
        </h2>
        
        {{ form_start(addForm, {'action': path('app_admin_new')}) }}
            <div style="display: flex; gap: 25px; align-items: flex-start; flex-wrap: wrap;">
                {# Colonne gauche : Zone image avec bouton discret #}
                <div style="width: 130px; height: 130px; border: 2px dashed #cca3a3; background-color: rgba(255,255,255,0.4); border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px; text-align: center; position: relative; flex-shrink: 0;">
                    <span style="font-size: 24px; color: #721c24; line-height: 1;">📷</span>
                    <label for="{{ addForm.imageFile.vars.id }}" style="font-size: 11px; font-weight: 700; color: #721c24; cursor: pointer; margin-top: 5px; text-decoration: underline;">
                        Choisir image
                    </label>
                    {{ form_widget(addForm.imageFile, {'attr': {'style': 'position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer; top:0; left:0;'}}) }}
                </div>

                {# Colonne droite : Champs de formulaire alignés horizontalement #}
                <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 15px; min-width: 300px;">
                    <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-end;">
                        {# Nom #}
                        <div style="flex: 2; min-width: 180px;">
                            <label for="{{ addForm.name.vars.id }}" style="font-weight: 700; font-size: 13px; color: #721c24; display: block; margin-bottom: 5px;">Nom</label>
                            {{ form_widget(addForm.name, {'attr': {'placeholder': 'Nom du sweat-shirt', 'style': 'width: 100%; padding: 8px; border: 1px solid #cca3a3; border-radius: 4px; font-size: 14px;'}}) }}
                        </div>

                        {# Prix #}
                        <div style="width: 90px; flex-shrink: 0;">
                            <label for="{{ addForm.price.vars.id }}" style="font-weight: 700; font-size: 13px; color: #721c24; display: block; margin-bottom: 5px;">Prix (€)</label>
                            {{ form_widget(addForm.price, {'attr': {'placeholder': '29.90', 'style': 'width: 100%; padding: 8px; border: 1px solid #cca3a3; border-radius: 4px; text-align: center; font-size: 14px;'}}) }}
                        </div>

                        {# Stocks #}
                        {% for size in ['XS', 'S', 'M', 'L', 'XL'] %}
                            <div style="width: 70px; flex-shrink: 0;">
                                <label for="{{ attribute(addForm, 'stock_' ~ size).vars.id }}" style="font-weight: 700; font-size: 13px; color: #721c24; display: block; margin-bottom: 5px; text-align: center;">Stock {{ size }}</label>
                                {{ form_widget(attribute(addForm, 'stock_' ~ size), {'attr': {'min': 0, 'style': 'width: 100%; padding: 8px; border: 1px solid #cca3a3; border-radius: 4px; text-align: center; font-size: 14px;'}}) }}
                            </div>
                        {% endfor %}
                    </div>

                    {# Checkbox et Bouton Ajouter sous la ligne d'inputs #}
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-top: 5px;">
                        <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #721c24; cursor: pointer;">
                            {{ form_widget(addForm.isFeatured) }}
                            Mettre en avant sur la page d'accueil
                        </label>
                        
                        <button type="submit" class="btn" style="background-color: #721c24; color: #fff; padding: 10px 30px; font-weight: 700; border-radius: 4px; border: none; cursor: pointer; text-transform: uppercase; font-size: 13px; letter-spacing: 0.5px;">
                            AJOUTER
                        </button>
                    </div>
                </div>
            </div>
        {{ form_end(addForm) }}
    </div>

    {# ========================================== #}
    {# 2. LISTE DES PRODUITS EXISTANTS (BAS)    #}
    {# ========================================== #}
    <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 20px; color: #111;">Sweat-shirts en catalogue</h2>

    <div class="admin-products-list" style="display: flex; flex-direction: column; gap: 25px;">
        {% for product in products %}
            {# Chaque produit est enveloppé dans sa propre balise <form> pour modification en ligne #}
            <div style="background-color: #ffffff; border: 1px solid #eee; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.01);">
                <form action="{{ path('app_admin_edit', {'id': product.id}) }}" method="post" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 15px;">
                    <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
                        {# Mini visuel #}
                        <div style="flex-shrink: 0; text-align: center;">
                            <img src="{{ asset('images/' ~ product.image) }}" onerror="this.src='https://placehold.co/70x80?text=Sweat';" alt="{{ product.name }}" style="width: 70px; height: 80px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; display: block; margin-bottom: 5px;">
                            <span style="font-size: 11px; color: #777; font-family: monospace;">#{{ product.id }}</span>
                        </div>

                        {# Formulaire Nom #}
                        <div style="flex: 2; min-width: 200px;">
                            <label style="font-weight: 600; font-size: 13px; color: #555; display: block; margin-bottom: 5px;">Nom</label>
                            <input type="text" name="name" value="{{ product.name }}" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                        </div>

                        {# Formulaire Prix #}
                        <div style="flex: 1; min-width: 100px;">
                            <label style="font-weight: 600; font-size: 13px; color: #555; display: block; margin-bottom: 5px;">Prix (€)</label>
                            <input type="number" name="price" value="{{ product.price }}" step="0.01" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                        </div>

                        {# Formulaire Image #}
                        <div style="flex: 2; min-width: 200px;">
                            <label style="font-weight: 600; font-size: 13px; color: #555; display: block; margin-bottom: 5px;">Modifier l'image (optionnel)</label>
                            <input type="file" name="imageFile" style="width: 100%; font-size: 12px;">
                        </div>

                        {# Formulaire Vedette #}
                        <div style="flex-shrink: 0; text-align: center; padding-top: 15px;">
                            <label style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: 600; color: #333;">
                                <input type="checkbox" name="isFeatured" {% if product.isFeatured %}checked{% endif %}>
                                Vedette (Home)
                            </label>
                        </div>
                    </div>

                    {# Stocks par taille #}
                    <div style="display: flex; gap: 15px; flex-wrap: wrap; background-color: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #e9ecef;">
                        {% for size in ['XS', 'S', 'M', 'L', 'XL'] %}
                            {# Recherche de la quantité actuelle en base #}
                            {% set qty = 0 %}
                            {% for stock in product.stocks %}
                                {% if stock.size == size %}
                                    {% set qty = stock.quantity %}
                                {% endif %}
                            {% endfor %}
                            <div style="flex: 1; min-width: 85px;">
                                <label style="font-weight: 700; font-size: 12px; display: block; margin-bottom: 5px; text-align: center; color: #555;">Stock {{ size }}</label>
                                <input type="number" name="stock_{{ size }}" value="{{ qty }}" min="0" required style="width: 100%; padding: 6px; text-align: center; border: 1px solid #ccc; border-radius: 4px;">
                            </div>
                        {% endfor %}
                    </div>

                    {# Boutons d'actions groupés en bas de chaque ligne #}
                    <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #eee; padding-top: 15px; margin-top: 5px;">
                        {# Jeton CSRF unique pour la modification de ce produit #}
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_product_' ~ product.id) }}">
                        
                        <button type="submit" class="btn" style="background-color: #007bff; color: #fff; padding: 8px 20px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; border-radius: 4px;">
                            MODIFIER
                        </button>
                </form>

                {# Formulaire de suppression sécurisé indépendant #}
                <form method="post" action="{{ path('app_admin_delete', {'id': product.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement le sweat-shirt &quot;{{ product.name }}&quot; ? \n\nLes stocks associés seront également supprimés en cascade.');" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                    <button type="submit" class="btn" style="background-color: #dc3545; color: #fff; padding: 8px 20px; font-size: 14px; font-weight: 600; border: none; cursor: pointer; border-radius: 4px;">
                        SUPPRIMER
                    </button>
                </form>
                    </div>
            </div>
        {% else %}
            <div style="text-align: center; padding: 50px; background-color: #ffffff; border-radius: 8px; border: 1px solid #eee;">
                <p style="color: #777; font-size: 16px;">Aucun sweat-shirt présent dans le catalogue.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
