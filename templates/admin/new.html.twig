{% extends 'base.html.twig' %}

{% block title %}Nouveau Produit - Admin - Stubborn{% endblock %}

{% block body %}
    <div style="margin-bottom: 30px;">
        <a href="{{ path('app_admin_index') }}" style="color: #666; text-decoration: none; font-size: 14px;">&larr; Retourner à la liste</a>
    </div>

    <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 30px;">Créer un nouveau sweat-shirt</h1>

    <div style="background-color: #ffffff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); max-width: 800px;">
        {{ form_start(form) }}
            <h3 style="font-size: 18px; font-weight: 600; border-bottom: 2px solid #f2f2f2; padding-bottom: 10px; margin-bottom: 20px; color: #333;">Informations générales</h3>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    {{ form_row(form.name) }}
                </div>
                <div>
                    {{ form_row(form.price) }}
                </div>
            </div>

            <div style="margin-bottom: 30px;">
                {{ form_row(form.imageFile) }}
            </div>

            <div style="margin-bottom: 30px; background-color: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #e9ecef;">
                {{ form_row(form.isFeatured) }}
            </div>

            <h3 style="font-size: 18px; font-weight: 600; border-bottom: 2px solid #f2f2f2; padding-bottom: 10px; margin-bottom: 20px; color: #333;">Stocks initiaux par taille</h3>
            
            <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; margin-bottom: 40px;">
                <div>
                    {{ form_row(form.stock_XS) }}
                </div>
                <div>
                    {{ form_row(form.stock_S) }}
                </div>
                <div>
                    {{ form_row(form.stock_M) }}
                </div>
                <div>
                    {{ form_row(form.stock_L) }}
                </div>
                <div>
                    {{ form_row(form.stock_XL) }}
                </div>
            </div>

            <button type="submit" class="btn" style="background-color: #28a745; width: 100%; padding: 12px; font-size: 16px;">
                Créer le sweat-shirt
            </button>
        {{ form_end(form) }}
    </div>
{% endblock %}
