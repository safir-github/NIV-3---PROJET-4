{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <form method="post">
        {# Affiche les erreurs de connexion (ex: identifiants incorrects) #}
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {# Si l'utilisateur est déjà connecté, on affiche son identifiant et un bouton de déconnexion #}
        {% if app.user %}
            <div class="mb-3">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Se déconnecter</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connexion</h1>
        
        <label for="username">Adresse email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
        
        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        
        {# Jeton CSRF pour protéger le formulaire contre les failles CSRF #}
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {# 
            Si on veut activer le "Se souvenir de moi" (remember me) plus tard, 
            il suffira de décommenter ce bloc et de le configurer dans security.yaml
            
            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Se souvenir de moi</label>
            </div>
        #}

        <button class="btn btn-lg btn-primary" type="submit">
            Se connecter
        </button>

        {# Lien visuel / placeholder pour respecter la maquette #}
        <div style="margin-top: 10px;">
            <a href="#" onclick="alert('Fonctionnalité de démonstration : réinitialisation non configurée.'); return false;" style="font-size: 14px; color: #666; text-decoration: underline;">
                Mot de passe oublié
            </a>
        </div>

        <div class="mt-4" style="border-top: 1px solid #eee; padding-top: 20px;">
            <p style="margin-bottom: 10px; font-weight: 600;">Pas encore inscrit ?</p>
            <a href="{{ path('app_register') }}" class="btn" style="background-color: #007bff; color: #fff; display: inline-block;">
                Créer un compte
            </a>
            <br><br>
            <a href="{{ path('app_home') }}" style="color: #666; text-decoration: none;">&larr; Retourner à l'accueil</a>
        </div>
    </form>
{% endblock %}
